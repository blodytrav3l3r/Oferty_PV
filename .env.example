# ==============================================
# WITROS Oferty — Konfiguracja środowiskowa
# ==============================================
# Skopiuj ten plik jako .env i dostosuj wartości
# cp .env.example .env
# ==============================================

# Port na którym nasłuchuje serwer (domyślnie 3000)
# Dla Dockera: docker-compose.yml ustawia PORT=10000 wewnątrz kontenera
PORT=3000

# Adres nasłuchiwania (0.0.0.0 = dostępny z sieci)
# UWAGA: W trybie production serwer automatycznie binduje się do 127.0.0.1
# (HTTPS terminuje reverse proxy — Caddy/Nginx). W trybie development domyślnie 0.0.0.0.
HOST=0.0.0.0

# Tryb pracy: 'development' lub 'production'
# W trybie dev: development (domyslnie), w produkcji: production
# Uwaga: start.bat automatycznie ustawia NODE_ENV=development dla trybu dev
# Uzyj: start.bat --prod dla trybu produkcyjnego
# W trybie produkcji:
# - pliki statyczne sa cache'owane (szybsze ladowanie)
# - naglowki bezpieczenstwa sa aktywne
# - HSTS + przekierowanie HTTP->HTTPS sa aktywne
NODE_ENV=development

# ==============================================
# HTTPS / Reverse Proxy (Caddy/Nginx)
# ==============================================
# Wymuszanie Secure flag na ciastku sesji (wymagane za reverse proxy).
# Domyślnie secure = true gdy NODE_ENV=production; ustaw jawnie przy
# serwowaniu przez HTTPS w trybie development.
# COOKIE_SECURE=true

# Przykładowa konfiguracja reverse proxy znajduje się w pliku Caddyfile
# (produkcja) oraz Caddyfile.dev (lokalny HTTPS z mkcert).

# ==============================================
# Bezpieczeństwo — WYMAGANE przy pierwszym uruchomieniu
# ==============================================
# Hasło administratora (min. 6 znaków)
# UWAGA: Jeśli nie ustawisz tej wartości, aplikacja NIE utworzy konta admina
DEFAULT_ADMIN_PASSWORD=anim123456

# ==============================================
# Monitorowanie błędów — Sentry (opcjonalnie)
# ==============================================
# DSN z https://sentry.io/settings/projects/ — jeśli pusty, Sentry wyłączony
SENTRY_DSN=

# ==============================================
# Baza danych SQLite
# ==============================================
# Domyślnie Prisma szuka względem folderu prisma/, więc ścieżka
# file:../data/app_database.sqlite wskazuje na /app/data/...
# Dla Dockera: file:/var/data/app_database.sqlite (wolumen)
DATABASE_URL=file:../data/app_database.sqlite?connection_limit=1&busy_timeout=30000
