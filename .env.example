# ==============================================
# S.O.K. — Konfiguracja środowiskowa
# ==============================================
# Skopiuj ten plik jako .env i dostosuj wartości
# cp .env.example .env
# ==============================================

# Port na którym nasłuchuje serwer (domyślnie 3000)
# Dla Dockera: docker-compose.yml ustawia PORT=10000 wewnątrz kontenera
PORT=3000

# Adres nasłuchiwania. Bezpieczny domyślny: 127.0.0.1 (tylko localhost).
# W trybie production serwer i tak domyślnie binduje się do 127.0.0.1,
# bo HTTPS terminuje reverse proxy (Caddy/Nginx).
# WAŻNE: Nie ustawiaj 0.0.0.0 w produkcji bez reverse proxy — wystawi aplikację
# na wszystkie interfejsy po surowym HTTP (omija TLS i naraża na ataki).
# W Dockerze (osobny kontener proxy) ustaw HOST=0.0.0.0 jawnie w compose/Dockerfile.
HOST=127.0.0.1

# Tryb pracy: 'development' lub 'production'
# W trybie dev: development (domyslnie), w produkcji: production
# Uwaga: start.bat automatycznie ustawia NODE_ENV=development dla trybu dev
# Uzyj: start.bat --prod dla trybu produkcyjnego
# W trybie produkcji:
# - pliki statyczne sa cache'owane (szybsze ladowanie)
# - naglowki bezpieczenstwa sa aktywne
# - HSTS + przekierowanie HTTP->HTTPS sa aktywne
NODE_ENV=development

# Cennik: jedyne źródło cen to wersje cennika (publikacja w panelu wersji).
# Tabele LIVE i snapshot JSON zostały usunięte w etapie 2.

# ==============================================
# HTTPS / Reverse Proxy (Caddy/Nginx)
# ==============================================
# Tryb transportu. Domyślnie HTTPS (brak zmiennej = true): przekierowanie
# HTTP->HTTPS, HSTS i CSP upgrade-insecure-requests aktywne.
# HTTPS_ENABLED=false = jawny tryb awaryjny HTTP dla LAN/VPN (ADR-017):
# brak redirectu, brak HSTS, CSP bez upgrade-insecure-requests, cookie bez
# flagi Secure. Ruch jest nieszyfrowany — tylko zaufana sieć lub VPN.
# NIE ustawiaj false jako domyślnego trybu produkcyjnego.
# HTTPS_ENABLED=false

# Wymuszanie Secure flag na ciastku sesji (wymagane za reverse proxy).
# Domyślnie secure = true gdy NODE_ENV=production; ustaw jawnie przy
# serwowaniu przez HTTPS w trybie development.
# COOKIE_SECURE=true

# Przykładowa konfiguracja reverse proxy znajduje się w pliku Caddyfile
# (produkcja) oraz Caddyfile.dev (lokalny HTTPS z mkcert).

# Liczba reverse proxy przed aplikacją (Caddy/Nginx = 1, Cloudflare→Nginx→App = 2).
# Domyślnie 1 — nie zwiększaj bez potrzeby. Wartość nieprawidłowa → 1 + WARN w logu.
# TRUST_PROXY=1

# Bazowy adres publiczny (origin) do przekierowania HTTP→HTTPS w produkcji.
# Ustawione = redirect nie zależy od nagłówka Host (ochrona przed open-redirect).
# Brak wartości → używany zwalidowany Host; Host nieprawidłowy → brak redirectu.
# PUBLIC_BASE_URL=https://oferty.example.pl

# ==============================================
# Bezpieczeństwo — WYMAGANE przy pierwszym uruchomieniu
# ==============================================
# Hasło administratora (min. 8 znaków)
# UWAGA: Jeśli nie ustawisz tej wartości, aplikacja NIE utworzy konta admina
# Przy świeżej instalacji instalatory (install.bat/install.sh) generują losowe hasło
# i zapisują je w .env; wartość poniżej to tylko znacznik (sentinel) — aplikacja
# przerywa start w KAŻDYM środowisku, gdy hasło jest równe temu placeholderowi
# lub znanemu wyciekniętemu sekretowi. Ustaw własne, losowe hasło.
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_PLEASE
# One-shot installer safeguard; kept false outside a verified default-secret repair.
RESET_ADMIN_PASSWORD_ON_BOOTSTRAP=false

# ==============================================
# Nazwa aplikacji (branding)
# ==============================================
# Aplikacja jest niezależna od nazwy — tytuły stron, logo, meta i komunikaty
# budowane są z tych wartości. Domyślnie: "S.O.K." / "System Ofert i Kalkulacji".
# APP_NAME=S.O.K.
# APP_SUBTITLE=System Ofert i Kalkulacji

# ==============================================
# Monitorowanie błędów — Sentry (opcjonalnie)
# ==============================================
# DSN z https://sentry.io/settings/projects/ — jeśli pusty, Sentry wyłączony
SENTRY_DSN=

# ==============================================
# PostgreSQL 18
# ==============================================
# PostgreSQL 18 Compose: POSTGRES_USER jest superuserem bootstrapowym tylko
# dla inicjalizacji wolumenu. Aplikacja używa odrębnych ról migrator/runtime/backup.
# Zmień każde hasło i użyj URL-encodingu przy znakach specjalnych.
POSTGRES_DB=sok
POSTGRES_USER=sok_bootstrap
POSTGRES_PASSWORD=REPLACE_WITH_BOOTSTRAP_SECRET
SOK_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_SECRET
SOK_APP_PASSWORD=REPLACE_WITH_RUNTIME_SECRET
SOK_BACKUP_PASSWORD=REPLACE_WITH_BACKUP_SECRET
MIGRATION_DATABASE_URL=postgresql://sok_migrator:REPLACE_WITH_MIGRATOR_SECRET@postgres:5432/sok?schema=public
DATABASE_URL=postgresql://sok_app:REPLACE_WITH_RUNTIME_SECRET@postgres:5432/sok?schema=public
BACKUP_DATABASE_URL=postgresql://sok_backup:REPLACE_WITH_BACKUP_SECRET@postgres:5432/sok?schema=public
# Nie używaj POSTGRES_USER ani MIGRATION_DATABASE_URL jako połączenia runtime.
# Dla backendu uruchomionego poza Compose użyj localhost i opublikowanego
# portu PostgreSQL w osobnym compose override (domyślny Compose go nie publikuje).

# Izolowana baza do testów backendu (docker-compose.postgres-test.yml).
# start-dev.bat uruchamia ją automatycznie na Windowsie; w innych workflow:
# docker compose -f docker-compose.postgres-test.yml up -d --wait
POSTGRES_TEST_PASSWORD=ci-only-sok-test
POSTGRES_TEST_PORT=55440
POSTGRES_TEST_URL=postgresql://sok_test:ci-only-sok-test@127.0.0.1:55440/sok_test?schema=public

# Playwright korzysta z tej samej izolowanej bazy testowej (osobny schemat na run).
PLAYWRIGHT_DATABASE_URL=postgresql://sok_test:ci-only-sok-test@127.0.0.1:55440/sok_test?schema=public
# Ustaw losowe, lokalne hasło administratora używane przez E2E.
TEST_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_TEST_SECRET

# ==============================================
# Monitoring backupu (opcjonalnie)
# ==============================================
# Gdy ustawione, `npm run backup:check` wysyła POST z raportem przy FAIL
# (backup brakujący lub starszy niż 26 h). Puste = brak alertu.
# Przykład ntfy.sh (bez konta): https://ntfy.sh/<twoj-losowy-temat>
BACKUP_ALERT_WEBHOOK=

# ==============================================
# AI / Model ML (opcjonalnie)
# ==============================================
# Wersja zestawu cech (features) używana przy predykcji i trenowaniu modelu ML.
# Zmiana na inną wersję wymaga danych treningowych wygenerowanych dla tej samej
# wersji — pozostaw domyślne, dopóki świadomie nie zmigrujesz modelu.
# Musi zgadzać się z ML_CONSTANTS.FEATURE_VERSION (src/config/mlConstants.ts).
ML_FEATURE_VERSION=v7

# Wersja modelu rankingowego (scoring / kolejność propozycji w ofercie).
# Pozostaw domyślną, dopóki nie wdrożysz nowego modelu i nie przetrenujesz go
# na danych z tej wersji.
ML_RANKING_VERSION=dual_v1
