{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/deepseek-v4.1-flash-free",
    "default_agent": "build",
    "instructions": ["AGENTS.md", ".opencode/rules/coding-style.md", ".opencode/rules/security.md"],
    "skills": [".opencode/skills"],
    "compaction": {
        "tail_turns": 6,
        "keep": {
            "tokens": 40000
        }
    },
    "permissions": [
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "graphify_list_prs",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "graphify_get_pr_impact",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "graphify_triage_prs",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "skill",
            "resource": "stitch-*",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "react-vite-dashboard",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "remotion",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "design-md",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "taste-design",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "shadcn-ui",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "canvas",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "babysit",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "banner-design",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "brand",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "design",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "design-system",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "gepeto",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "migrate-to-builds",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "migrate-to-skills",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "pinokio",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "sdk",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "site-md",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "slides",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "statusline",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "ui-styling",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "create-hook",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "create-rule",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "create-skill",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "create-subagent",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "update-cli-config",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "update-cursor-settings",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "loop",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "enhance-prompt",
            "effect": "deny"
        },
        {
            "action": "skill",
            "resource": "split-to-prs",
            "effect": "deny"
        },
        {
            "action": "shell",
            "resource": "git push *",
            "effect": "ask"
        }
    ],
    "agents": {
        "title": {
            "model": "opencode/deepseek-v4.1-flash-free"
        },
        "build": {
            "description": "Primary coding agent for development work",
            "mode": "primary"
        },
        "planner": {
            "description": "Architectural planning and complex refactoring specialist",
            "mode": "subagent",
            "system": "{file:prompts/agents/planner.txt}",
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "architect": {
            "description": "System design and scalability specialist",
            "mode": "subagent",
            "system": "{file:prompts/agents/architect.txt}",
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "code-reviewer": {
            "description": "Code quality and maintainability reviewer",
            "mode": "subagent",
            "system": "{file:prompts/agents/code-reviewer.txt}",
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "silent-failure-hunter": {
            "description": "Review code for silent failures, swallowed errors, bad fallbacks, and missing error propagation",
            "mode": "subagent",
            "system": "{file:prompts/agents/silent-failure-hunter.txt}",
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "deny"
                }
            ]
        },
        "security-reviewer": {
            "description": "Security analysis and vulnerability detection",
            "mode": "subagent",
            "system": "{file:prompts/agents/security-reviewer.txt}"
        },
        "tdd-guide": {
            "description": "Test-driven development enforcement",
            "mode": "subagent",
            "system": "{file:prompts/agents/tdd-guide.txt}"
        },
        "build-error-resolver": {
            "description": "Build and TypeScript error fixer",
            "mode": "subagent",
            "system": "{file:prompts/agents/build-error-resolver.txt}"
        },
        "refactor-cleaner": {
            "description": "Dead code and duplication remover",
            "mode": "subagent",
            "system": "{file:prompts/agents/refactor-cleaner.txt}"
        },
        "e2e-runner": {
            "description": "Playwright E2E testing specialist",
            "mode": "subagent",
            "system": "{file:prompts/agents/e2e-runner.txt}"
        },
        "doc-updater": {
            "description": "Documentation updater",
            "mode": "subagent",
            "system": "{file:prompts/agents/doc-updater.txt}"
        },
        "ponytail-mode": {
            "description": "Minimalist coding mode (YAGNI, no overengineering, native-first solutions)",
            "mode": "subagent"
        }
    },
    "mcp": {
        "servers": {
            "graphify": {
                "type": "local",
                "command": [
                    "uvx",
                    "--from",
                    "graphifyy[mcp]",
                    "graphify-mcp",
                    "--graph",
                    "graphify-out/graph.json"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 30000,
                    "execution": 30000
                }
            }
        }
    }
}
