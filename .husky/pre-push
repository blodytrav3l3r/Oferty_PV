#!/bin/sh
# Pre-push S.O.K. sprawdza najpierw połączenie z izolowaną bazą testową.
# Kroki niezależne w grupach A–C idą równolegle, a grupy idą sekwencyjnie:
#   A: version + encoding + appname + licenses + collisions + ratchet + prices (~13 s)
#   B: lint BE + lint FE (~25 s)
#   C: typecheck BE + typecheck FE (~37 s)
#   D: test:quick:lite + test:git-safety (~225 s, najdłuższy krok)
# Logi kroków lądują w plikach tymczasowych — wypisywane tylko przy FAIL,
# żeby komunikaty z różnych kroków się nie przeplatały.

run_parallel() {
    tmpdir=$(mktemp -d 2>/dev/null || mktemp -d -t prepush) || exit 1
    idx=0
    pids=""
    for job in "$@"; do
        idx=$((idx + 1))
        # Etykieta do pliku: tokeny pid:idx nie mogą zawierać spacji z joba.
        printf '%s' "$job" >"$tmpdir/$idx.cmd"
        sh -c "$job" >"$tmpdir/$idx.log" 2>&1 &
        pids="$pids $!:$idx"
    done
    fail=0
    for p in $pids; do
        pid=${p%%:*}
        n=${p#*:}
        job=$(cat "$tmpdir/$n.cmd")
        if wait "$pid"; then
            echo "✓ $job"
        else
            echo "❌ $job"
            cat "$tmpdir/$n.log"
            fail=1
        fi
    done
    rm -rf "$tmpdir"
    return $fail
}

node scripts/postgres-test-url.cjs || { echo "❌ Konfiguracja PostgreSQL do testów — sprawdź POSTGRES_TEST_URL"; exit 1; }

echo "── pre-push A: wersja/kodowanie/nazwa ──"
run_parallel \
    "npm run version:check" \
    "npm run encoding:check" \
    "npm run appname:check" \
    "npm run licenses:check" \
    "npm run collisions:check" \
    "npm run ratchet:check" \
    "npm run prices:verify" || { echo "❌ Grupa A — przerwano push"; exit 1; }

echo "── pre-push B: lint ──"
run_parallel \
    "npm run lint" \
    "npm run lint:frontend" || { echo "❌ Lint — uruchom npm run lint i napraw błędy"; exit 1; }

echo "── pre-push C: typecheck ──"
run_parallel \
    "npm run typecheck" \
    "npm run typecheck:frontend" || { echo "❌ Typecheck"; exit 1; }

echo "── pre-push D: testy (sekwencyjnie) ──"
# UWAGA: testy MUSZĄ iść szeregowo, nie równolegle — suity git-safety
# tworzą/usuwają tmp_git_safety_*.txt w root repo, a równoległe suity
# skanujące drzewo (np. appNameCheck) łapią ENOENT na znikających plikach
# i testy git-safety łapią index.lock. Zweryfikowane dwoma pushami.
npm run test:quick:lite 2>&1 || { echo "❌ Testy — uruchom npm run test:quick:lite"; exit 1; }
npm run test:git-safety 2>&1 || { echo "❌ Testy git-safety — uruchom npm run test:git-safety"; exit 1; }

echo "✓ pre-push zielony"
