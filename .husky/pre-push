#!/bin/sh
# Pre-push uruchamia szybkie kontrole lokalne; testy wykonuje CI po pushu.
# Kroki niezależne w grupach A–C idą równolegle:
#   A: version + encoding + appname + licenses + collisions + ratchet + prices (~13 s)
#   B: lint BE + lint FE (~25 s)
#   C: typecheck BE + typecheck FE (~37 s)
# Logi kroków lądują w plikach tymczasowych — wypisywane tylko przy FAIL,
# żeby komunikaty z różnych kroków się nie przeplatały.

run_parallel() {
    tmpdir=$(mktemp -d 2>/dev/null || mktemp -d -t prepush) || exit 1
    idx=0
    pids=""
    for job in "$@"; do
        idx=$((idx + 1))
        # Etykieta do pliku: tokeny pid:idx nie mogą zawierać spacji z joba.
        printf '%s' "$job" >"$tmpdir/$idx.cmd"
        sh -c "$job" >"$tmpdir/$idx.log" 2>&1 &
        pids="$pids $!:$idx"
    done
    fail=0
    for p in $pids; do
        pid=${p%%:*}
        n=${p#*:}
        job=$(cat "$tmpdir/$n.cmd")
        if wait "$pid"; then
            echo "✓ $job"
        else
            echo "❌ $job"
            cat "$tmpdir/$n.log"
            fail=1
        fi
    done
    rm -rf "$tmpdir"
    return $fail
}

echo "── pre-push A: wersja/kodowanie/nazwa ──"
run_parallel \
    "npm run version:check" \
    "npm run encoding:check" \
    "npm run appname:check" \
    "npm run licenses:check" \
    "npm run collisions:check" \
    "npm run ratchet:check" \
    "npm run prices:verify" || { echo "❌ Grupa A — przerwano push"; exit 1; }

echo "── pre-push B: lint ──"
run_parallel \
    "npm run lint" \
    "npm run lint:frontend" || { echo "❌ Lint — uruchom npm run lint i napraw błędy"; exit 1; }

echo "── pre-push C: typecheck ──"
run_parallel \
    "npm run typecheck" \
    "npm run typecheck:frontend" || { echo "❌ Typecheck"; exit 1; }

echo "✓ pre-push zielony"
