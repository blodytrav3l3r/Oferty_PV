# Auto detect text files and normalize to LF in Git (S.O.K. policy:
# repo przechowuje LF; Windows/CRLF tylko w worktree; core.autocrlf=false)
* text=auto eol=lf

# Binary files: never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.sqlite binary

# Windows batch files MUST keep CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
graphify-out/graph.json merge=graphify
