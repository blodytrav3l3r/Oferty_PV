{
    "name": "sok-oferty",
    "version": "1.23.0",
    "main": "dist/server.js",
    "scripts": {
        "start": "node dist/server.js",
        "prestart": "node scripts/minify-css.mjs",
        "minify:css": "node scripts/minify-css.mjs",
        "bundle:scripts": "node scripts/bundle-scripts.mjs",
        "dev": "npm run dev:backend",
        "dev:backend": "ts-node-dev --respawn --transpile-only ./server.ts",
        "build": "tsc && node scripts/copy-prisma-client.mjs",
        "build:watch": "tsc --watch",
        "test": "jest --coverage --testPathIgnorePatterns=git-safety",
        "test:watch": "jest --watch",
        "test:quick": "jest --no-coverage --testPathIgnorePatterns=git-safety",
        "test:quick:lite": "jest --no-coverage --testPathIgnorePatterns=tests/migrations --testPathIgnorePatterns=git-safety",
        "test:git-safety": "jest --selectProjects git-safety --runInBand --no-coverage",
        "test:alignment": "node tests/playwright/excelEmptyRowAlignment.cjs",
        "test:parity": "node tests/playwright/excelVirtualParity.cjs",
        "test:bench": "node tests/playwright/excelVirtualBench.cjs",
        "test:e2e-appname": "node tests/playwright/appNameConsistency.cjs",
        "test:e2e-appname:spawn": "npm run build && node tests/playwright/appNameConsistency.cjs --spawn",
        "test:e2e": "playwright test",
        "test:axe": "playwright test tests/playwright/a11yAxe.spec.ts",
        "test:frontend": "jest --testPathPattern=tests/frontend --no-coverage",
        "validate": "npm run typecheck && npm run typecheck:frontend && npm run lint && npm run lint:frontend && npm run appname:check && npm run licenses:check && npm run test:quick && npm run collisions:check",
        "lint": "eslint src/**/*.{js,ts}",
        "lint:fix": "eslint src/**/*.{js,ts} --fix",
        "lint:frontend": "eslint public/js --ext .js",
        "typecheck": "tsc --noEmit",
        "typecheck:frontend": "tsc -p tsconfig.frontend.json",
        "format": "prettier --write \"**/*.{js,ts,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,ts,json,md}\"",
        "backup": "ts-node scripts/backup.ts",
        "restore": "node scripts/restore-db.js",
        "ai:setup": "ts-node scripts/setupAi.ts",
        "backup:install-cron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-backup-cron.ps1",
        "backup:uninstall-cron": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-backup-cron.ps1",
        "prisma:seed": "ts-node prisma/seed.ts",
        "export:seed": "node scripts/export-settings-to-seed.mjs",
        "cleanup:legacy-pricing": "node scripts/cleanup-legacy-settings.cjs",
        "prices:export": "ts-node scripts/prices-export.ts",
        "prices:import": "ts-node scripts/prices-import.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:deploy": "prisma migrate deploy",
        "prisma:status": "prisma migrate status",
        "prisma:reset": "prisma migrate reset",
        "prisma:studio": "prisma studio",
        "release": "standard-version --commit-all",
        "version:check": "node scripts/check-version.mjs",
        "version:patch": "node scripts/bump-version.mjs patch",
        "version:minor": "node scripts/bump-version.mjs minor",
        "version:major": "node scripts/bump-version.mjs major",
        "version:bump": "node scripts/bump-version.mjs",
        "appname:check": "node scripts/check-appname.cjs",
        "collisions:check": "node scripts/check-global-collisions.mjs",
        "commit": "node scripts/commit.mjs",
        "deploy": "node scripts/deploy.mjs",
        "rollback": "node scripts/rollback.mjs",
        "deploy:check": "node scripts/post-deploy-check.mjs",
        "skills:build": "node scripts/skill-cli.mjs build-cost",
        "skills:stats": "node scripts/skill-cli.mjs stats",
        "skills:validate": "node scripts/skill-cli.mjs validate",
        "skills:cost": "node scripts/skill-cli.mjs cost",
        "skills:deps": "node scripts/skill-cli.mjs deps",
        "skills:plan": "node scripts/skill-cli.mjs plan",
        "skills:capabilities": "node scripts/skill-cli.mjs capabilities",
        "skills:provider-resolve": "node scripts/skill-cli.mjs provider-resolve",
        "skills:feedback-record": "node scripts/skill-cli.mjs feedback-record",
        "skills:feedback-show": "node scripts/skill-cli.mjs feedback-show",
        "skills:utility-recalc": "node scripts/skill-cli.mjs utility-recalc",
        "release:minor": "standard-version --release-as minor --commit-all",
        "release:patch": "standard-version --release-as patch --commit-all",
        "release:major": "standard-version --release-as major --commit-all",
        "release:dry": "standard-version --dry-run",
        "release:first": "standard-version --first-release --commit-all",
        "encoding:check": "node scripts/encoding-integrity.js check",
        "encoding:fix": "node scripts/encoding-integrity.js fix",
        "encoding:staged": "node scripts/encoding-integrity.js staged",
        "licenses:generate": "node scripts/generate-licenses.mjs",
        "licenses:check": "node scripts/check-licenses.mjs",
        "benchmark": "node scripts/benchmark.mjs",
        "benchmark:quick": "node scripts/benchmark.mjs 10",
        "benchmark:autoselect": "node scripts/benchmark-autoselect.mjs",
        "benchmark:autoselect:quick": "node scripts/benchmark-autoselect.mjs --quick --repeats=10 --warmup=3",
        "git:safety": "node scripts/git-safety/cli.mjs",
        "git:safety:list": "node scripts/git-safety/cli.mjs list",
        "git:safety:inspect": "node scripts/git-safety/cli.mjs inspect",
        "git:safety:verify": "node scripts/git-safety/cli.mjs verify",
        "git:safety:restore": "node scripts/git-safety/cli.mjs restore",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "keywords": [],
    "author": "",
    "license": "SEE LICENSE IN LICENSE",
    "description": "S.O.K. - System Ofert i Kalkulacji (TypeScript + Prisma)",
    "dependencies": {
        "@prisma/client": "^6.0.0",
        "@sentry/node": "^10.59.0",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "docx": "^9.6.1",
        "dotenv": "^17.4.1",
        "express": "^4.22.2",
        "helmet": "^8.1.0",
        "puppeteer": "^24.43.1",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^9.39.4",
        "@playwright/test": "^1.62.1",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^4.17.25",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.9.0",
        "husky": "^9.1.7",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.4.1",
        "js-yaml": "^5.3.0",
        "jszip": "^3.10.1",
        "lint-staged": "^17.0.7",
        "playwright": "^1.62.1",
        "prettier": "^3.9.4",
        "prisma": "^6.0.0",
        "standard-version": "^9.5.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.67.0"
    },
    "lint-staged": {
        "*.{js,ts,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css,html}": [
            "prettier --write"
        ],
        "*.{html,css,js,ts,json,md,yml,yaml,sql,xml,mjs,cjs}": [
            "node scripts/encoding-integrity.js staged"
        ]
    }
}
